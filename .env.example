# Copy to `.env` and adjust as needed. Do not commit `.env`.

# Optional overrides (defaults work for local repo layout)
# PROJECT_ROOT=
LOG_LEVEL=INFO
HTTP_TIMEOUT_SECONDS=30
HTTP_REQUEST_DELAY_MS=400
PRODUCT=mega645
# Set to 0 in CI/browser to block live vietlott.vn from the UI Update button
VIETLOTT_ALLOW_LIVE_FETCH=1
